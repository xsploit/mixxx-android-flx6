+bool QmlLibraryProxy::hasAndroidAllFilesAccess() const {
+#if defined(Q_OS_ANDROID)
+    const jint sdkVersion = QJniObject::getStaticField<jint>(
+            "android/os/Build$VERSION", "SDK_INT");
+    if (sdkVersion < 30) {
+        return true;
+    }
+    return QJniObject::callStaticMethod<jboolean>(
+            "android/os/Environment", "isExternalStorageManager");
+#else
+    return true;
+#endif
+}
+
+void QmlLibraryProxy::requestAndroidAllFilesAccess() const {
+#if defined(Q_OS_ANDROID)
+    const QJniObject action = QJniObject::getStaticObjectField(
+            "android/provider/Settings",
+            "ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION",
+            "Ljava/lang/String;");
+    QJniObject intent("android/content/Intent",
+            "(Ljava/lang/String;)V",
+            action.object());
+    const QJniObject activity = QtAndroidPrivate::activity();
+    const QJniObject packageName = activity.callObjectMethod<jstring>("getPackageName");
+    const QJniObject packageUri = QJniObject::fromString(
+            QStringLiteral("package:%1").arg(packageName.toString()));
+    const QJniObject uri = QJniObject::callStaticObjectMethod(
+            "android/net/Uri",
+            "parse",
+            "(Ljava/lang/String;)Landroid/net/Uri;",
+            packageUri.object<jstring>());
+    const QJniObject configuredIntent = intent.callObjectMethod("setData",
+            "(Landroid/net/Uri;)Landroid/content/Intent;",
+            uri.object<jobject>());
+    QtAndroidPrivate::startActivity(intent, 0);
+#endif
+}
