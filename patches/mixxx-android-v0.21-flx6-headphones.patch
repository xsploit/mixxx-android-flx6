@@ -238,17 +238,43 @@ bool QmlSoundManagerProxy::hasMicInputs() {
     return m_config.hasMicInputs();
 }
 
+namespace {
+QList<SoundDevicePointer> androidOutputDevices(SoundManager* soundManager) {
+    QList<SoundDevicePointer> devices;
+    for (const QString& api : soundManager->getHostAPIList()) {
+        devices.append(soundManager->getDeviceList(api, true, false));
+    }
+    return devices;
+}
+
+SoundDevicePointer findFlx6Output(SoundManager* soundManager) {
+    const auto devices = androidOutputDevices(soundManager);
+    for (const auto& device : devices) {
+        if (device->getDisplayName().contains(
+                    QStringLiteral("FLX6"), Qt::CaseInsensitive)) {
+            return device;
+        }
+    }
+    // Some Android builds replace the USB product name with the phone model.
+    // The FLX6 is the only four-output device in this dedicated build, so use
+    // that capability as a safe fallback instead of falling back to stereo.
+    for (const auto& device : devices) {
+        if (device->getNumOutputChannels() >= 4) {
+            return device;
+        }
+    }
+    return {};
+}
+} // namespace
