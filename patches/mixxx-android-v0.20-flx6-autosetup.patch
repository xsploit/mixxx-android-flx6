diff --git a/src/qml/qmlsoundmanagerproxy.cpp b/src/qml/qmlsoundmanagerproxy.cpp
index f9c68c569..c339898b6 100644
--- a/src/qml/qmlsoundmanagerproxy.cpp
+++ b/src/qml/qmlsoundmanagerproxy.cpp
@@ -238,6 +238,68 @@ bool QmlSoundManagerProxy::hasMicInputs() {
     return m_config.hasMicInputs();
 }
 
+QString QmlSoundManagerProxy::flx6AudioStatus() const {
+    const auto devices = m_pSoundManager->getDeviceList(QString(), true, false);
+    for (const auto& device : devices) {
+        if (!device->getDisplayName().contains(
+                    QStringLiteral("FLX6"), Qt::CaseInsensitive)) {
+            continue;
+        }
+        const int channels = device->getNumOutputChannels();
+        const int configured = m_config.getOutputs().count(device->getDeviceId());
+        const int expectedConnections = channels >= 4 ? 2 : 1;
+        if (configured >= expectedConnections) {
+            return channels >= 4
+                    ? tr("Ready - Master 1/2 and headphones 3/4")
+                    : tr("Ready - Master 1/2 (no separate headphone channels exposed)");
+        }
+        return tr("Detected - tap CHECK AND SET UP FLX6");
+    }
+    return tr("Not detected - Android has not exposed the FLX6 sound card");
+}
+
+QString QmlSoundManagerProxy::autoConfigureFlx6() {
+    if (m_commitInProgress.loadAcquire() == 1) {
+        return tr("Setting up audio...");
+    }
+
+    const auto devices = m_pSoundManager->getDeviceList(QString(), true, false);
+    SoundDevicePointer flx6;
+    for (const auto& device : devices) {
+        if (device->getDisplayName().contains(
+                    QStringLiteral("FLX6"), Qt::CaseInsensitive)) {
+            flx6 = device;
+            break;
+        }
+    }
+    if (!flx6) {
+        return tr("Not detected - Android has not exposed the FLX6 sound card");
+    }
+
+    const int channels = flx6->getNumOutputChannels();
+    if (channels < 2) {
+        return tr("Detected, but Android reports fewer than two audio channels");
+    }
+
+    m_config.clearOutputs();
+    m_config.addOutput(flx6->getDeviceId(),
+            AudioOutput(AudioPathType::Main,
+                    0,
+                    mixxx::audio::ChannelCount::stereo(),
+                    0));
+    if (channels >= 4) {
+        m_config.addOutput(flx6->getDeviceId(),
+                AudioOutput(AudioPathType::Headphones,
+                        2,
+                        mixxx::audio::ChannelCount::stereo(),
+                        0));
+    }
+    commit();
+    return channels >= 4
+            ? tr("Ready - Master 1/2 and headphones 3/4")
+            : tr("Ready - Master 1/2 (no separate headphone channels exposed)");
+}
+
 std::shared_ptr<SoundManager> QmlSoundManagerProxy::internal() const {
     return m_pSoundManager;
 }
