+QString QmlControllerManagerProxy::flx6Status() const {
+    for (Controller* controller : m_pControllerManager->getControllers()) {
+        if (!controller->getName().contains(
+                    QStringLiteral("FLX6"), Qt::CaseInsensitive)) {
+            continue;
+        }
+        if (controller->isOpen()) {
+            return tr("Ready - MIDI active and FLX6 mapping loaded");
+        }
+        return tr("Detected - close and reopen Mixxx to finish setup");
+    }
+    return tr("Not detected - connect FLX6, then reopen Mixxx");
+}
